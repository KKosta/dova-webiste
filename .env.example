# Notion internal integration secret. The integration must be connected to the
# "Dova.io waitlist signup" database (database ••• menu → Connections).
NOTION_TOKEN=
# Optional: override the Notion data source the rows go into (defaults to Dova.io waitlist signup).
NOTION_DATA_SOURCE_ID=

# Optional: also POST each submission as JSON here (Zapier, Make, Slack workflow…).
WAITLIST_WEBHOOK_URL=
